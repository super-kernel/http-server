{
    "name": "super-kernel/http-server",
    "description": "The http-server component for super-kernel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "swoole",
        "super-kernel",
        "http-server"
    ],
    "homepage": "https://github.com/super-kernel/http-server",
    "support": {
        "issues": "https://github.com/super-kernel/http-server/issues",
        "source": "https://github.com/super-kernel/http-server"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\HttpServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernelTest\\HttpServer\\": "tests/"
        }
    },
    "config": {
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.4.0",
        "ext-swoole": "~6.0.0",
        "laminas/laminas-diactoros": "~3.8.0",
        "nikic/fast-route": "~1.3.0",
        "psr/http-message": "~2.0.0",
        "psr/http-server-middleware": "~1.0.0",
        "super-kernel/context": "~1.0.0",
        "super-kernel/server": "dev-wheakerd",
        "super-kernel/stream": "~1.0.0"
    },
    "require-dev": {
        "super-kernel/bootstrap": "~1.0.0",
        "super-kernel/di": "~1.0.0",
        "super-kernel/event-dispatcher": "~1.0.0",
        "super-kernel/framework": "~1.0.0",
        "swoole/ide-helper": "~6.0.0"
    }
}
