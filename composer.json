{
    "name": "super-kernel/http-server",
    "description": "Attribute-driven HTTP routing, middleware, and Swoole integration for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "ext-swoole": ">=6.2.3 <6.3",
        "nikic/fast-route": "^1.3.1",
        "psr/container": "^2.0.2",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "super-kernel/annotator": "dev-main",
        "super-kernel/attribute": "dev-main",
        "super-kernel/context": "dev-main",
        "super-kernel/contract": "dev-main",
        "super-kernel/exception-dispatcher": "dev-main",
        "super-kernel/http-message": "dev-main",
        "super-kernel/reflector": "dev-main",
        "super-kernel/server": "dev-main",
        "super-kernel/support": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.3",
        "swoole/ide-helper": "^6.2.3"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\HttpServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\HttpServer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
